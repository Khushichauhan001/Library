// Prisma schema for the Study Library owner-only admin tool.
// Uses the standard Prisma Client against a pooled Postgres connection
// string (see lib/prisma.ts and .env.example) so it works well inside
// Vercel's serverless functions without needing a long-lived DB connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Seat {
  id         String   @id @default(cuid())
  seatNumber Int      @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // A seat has at most one *currently* seated student at a time. When a
  // student leaves, seatId is nulled out on their record, freeing the seat.
  // A unique constraint on Student.seatId (below) is what actually makes
  // "a seat can never be double-booked" a DB-enforced guarantee rather than
  // just an application-level check.
  currentStudent Student?
}

enum StudentStatus {
  ACTIVE
  LEFT
}

model Student {
  id         String        @id @default(cuid())
  name       String
  phone      String
  seatId     String?       @unique
  seat       Seat?         @relation(fields: [seatId], references: [id])
  joinDate   DateTime      @default(now())
  status     StudentStatus @default(ACTIVE)

  // Standard monthly fee (usually derived from the seat's normal rate at
  // time of joining). customFee overrides this when set.
  monthlyFee Decimal       @db.Decimal(10, 2)
  customFee  Decimal?      @db.Decimal(10, 2)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  payments Payment[]

  @@index([status])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIAL
}

model Payment {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])

  amount         Decimal       @db.Decimal(10, 2)

  // The month this payment is "for" - stored as the 1st of that month.
  periodMonth    DateTime

  paidOn         DateTime      @default(now())

  // The new due date this payment pushes the student to.
  dueDateAfter   DateTime

  mode           PaymentMode
  status         PaymentStatus @default(PAID)

  // Sequential/human-readable receipt number, e.g. "RCPT-0001".
  receiptNo      String        @unique

  // Groups payments made together in one bulk "mark paid" action.
  batchId        String?

  // For advance payments that cover multiple months at once.
  monthsCovered  Int           @default(1)

  createdAt      DateTime      @default(now())

  @@index([studentId])
  @@index([batchId])
}

/// Revenue that has already been collected but whose Student row has since
/// been permanently deleted.
///
/// Deleting a student removes them (and their Payment rows) from every
/// *forward-looking* calculation - dues, occupancy, active counts. It must
/// not rewrite history: money collected in a past month was really collected,
/// so that month's total has to stay exactly what it was. Before the payments
/// are deleted they are summed per calendar month (by paidOn, the month the
/// cash actually came in) and stored here, and the Reports page adds these
/// totals back on top of the live Payment totals.
///
/// This is an append-only ledger of deleted students' contributions. Nothing
/// in the app links back to the student - the row is deliberately just a name
/// snapshot, so deleting a student really does remove their record.
model ArchivedRevenue {
  id             String   @id @default(cuid())

  /// Name the student had at the moment they were deleted, for reports/CSV.
  studentName    String

  /// First day (UTC) of the calendar month the money was collected in.
  /// Mirrors how the Reports page buckets Payment.paidOn.
  collectedMonth DateTime

  /// Sum of that month's deleted payments.
  amount         Decimal  @db.Decimal(10, 2)

  /// How many Payment rows this row replaces.
  paymentCount   Int

  archivedAt     DateTime @default(now())

  @@index([collectedMonth])
}
