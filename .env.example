# Copy this file to .env (do not commit the real .env) and fill in real values.
# See README.md for a beginner-friendly, step-by-step walkthrough.

# --- Database -----------------------------------------------------------
# A Postgres connection string. Use a POOLED connection string, since this
# app runs as short-lived serverless functions on Vercel and cannot rely on
# a single long-lived DB connection.
#
# Neon (https://neon.tech, free tier):
#   Dashboard -> your project -> "Connection Details" -> copy the "Pooled
#   connection" string (it contains "-pooler" in the hostname).
#
# Supabase (https://supabase.com, free tier):
#   Project Settings -> Database -> "Connection string" -> choose
#   "Transaction" mode (this is the pooled one), port 6543.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth -------------------------------------------------------------
# A random secret used to sign login session tokens. Generate one with:
#   openssl rand -base64 32
# (On Windows, or if you don't have openssl, you can instead run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# )
NEXTAUTH_SECRET=""

# The public URL of your deployed app. For local development this is:
NEXTAUTH_URL="http://localhost:3000"
# When deployed to Vercel, set this to your real URL, e.g.
# NEXTAUTH_URL="https://your-library.vercel.app"

# --- Admin login (single account, no signup flow) ------------------------
# Pick any username for yourself, e.g. your first name.
ADMIN_USERNAME="admin"

# NEVER put your plain-text password here. Generate a hashed version and
# paste the hash below. From the project folder, run:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_REAL_PASSWORD', 10))"
# This prints a long string starting with "$2" - copy that whole string.
ADMIN_PASSWORD_HASH=""
